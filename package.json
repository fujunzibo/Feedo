{
  "name": "solana",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start --prefix backend",
    "dev:proxy": "npm run start:proxy",
    "dev": "concurrently \"npm run dev:proxy\" \"npm run dev:backend\" \"npm run dev:frontend\"",
   "build:all": "npx --cwd frontend npm run build && npx --cwd backend npm run build",
    "start:prod": "concurrently \"npm run dev:proxy\" \"npm run dev:backend\"",
    "deploy": "npm run build --prefix backend && npx wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.12.2",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helius-sdk": "^2.0.2",
    "node-cron": "^4.2.1",
    "pino": "^10.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "concurrently": "^9.2.1",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
