{
  // Visit https://aka.ms/tsconfig to read more about this file
  // Root tsconfig for Monorepo - serves as base configuration
  // Individual packages (backend, frontend, shared) have their own tsconfig.json
  "compilerOptions": {
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "commonjs",
    "target": "es2021",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  // This is a base configuration for the Monorepo
  // Each sub-project (backend, frontend, shared) has its own tsconfig.json
  "include": ["_tsconfig.d.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/dist/**",
    "backend",
    "frontend",
    "shared"
  ]
}
